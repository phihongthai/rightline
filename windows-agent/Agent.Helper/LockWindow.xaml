<Window x:Class="KidSafe.Agent.Helper.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KidSafe" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="#FF0F172A" AllowsTransparency="False" WindowStartupLocation="Manual">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
            <TextBlock Text="🔒" FontSize="72" HorizontalAlignment="Center"/>
            <TextBlock Text="Máy đã bị khóa" Foreground="White" FontSize="36" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="ReasonText" Foreground="#FFCBD5E1" FontSize="20" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="UsageText" Foreground="#FF94A3B8" FontSize="14" TextAlignment="Center" Margin="0,6,0,0"/>

            <Button x:Name="OpenRequestButton" Content="Xin thêm giờ" FontSize="20" Padding="16,12" Margin="0,32,0,0"
                    Background="#FF2563EB" Foreground="White" BorderThickness="0" Click="OpenRequest_Click"/>

            <StackPanel x:Name="RequestPanel" Visibility="Collapsed" Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Số phút:" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                    <TextBox x:Name="MinutesBox" Text="15" Width="80" FontSize="18" Margin="10,0,0,0" MaxLength="3"
                             PreviewTextInput="Minutes_PreviewTextInput"/>
                </StackPanel>
                <TextBox x:Name="ReasonBox" Height="80" Margin="0,12,0,0" FontSize="16" TextWrapping="Wrap"
                         AcceptsReturn="True" MaxLength="500"/>
                <TextBlock Text="Lời nhắn cho phụ huynh (không bắt buộc)" Foreground="#FF94A3B8" FontSize="12" Margin="0,2,0,0"/>
                <Button x:Name="SendButton" Content="Gửi yêu cầu" FontSize="18" Padding="12,10" Margin="0,12,0,0"
                        Background="#FF16A34A" Foreground="White" BorderThickness="0" Click="Send_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="#FFFDE68A" FontSize="16" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</Window>
